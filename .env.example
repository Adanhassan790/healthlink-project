# HealthLink Environment Variables Template
# Copy this file to .env and fill in actual values
# IMPORTANT: Never commit .env to version control (it's in .gitignore)

# ============== DJANGO CORE SETTINGS ==============

# Generate a secure SECRET_KEY at: https://djecrety.ir/
SECRET_KEY=your-super-secret-key-change-in-production

# Set to True only in development, False in production
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# ============== DATABASE ==============
# For local development, SQLite is used by default (no need to set DATABASE_URL)
# For Railway with PostgreSQL, Railway automatically sets DATABASE_URL
# Format: postgres://user:password@host:port/database
# DATABASE_URL=postgres://user:password@localhost:5432/healthlink

# ============== CORS & SECURITY ==============

# Comma-separated list of allowed CORS origins (for frontend requests)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated list of trusted origins for CSRF protection
# Must include your domain with https in production
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============== M-PESA PAYMENT INTEGRATION ==============

# Environment: 'sandbox' for testing, 'production' for live transactions
MPESA_ENVIRONMENT=sandbox

# Get these credentials from M-Pesa Daraja API
# For Sandbox: https://developer.safaricom.co.ke/ (Free to register)
# Business Account Consumer Key
MPESA_CONSUMER_KEY=your-mpesa-consumer-key

# Business Account Consumer Secret
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret

# Business Shortcode (or Till Number)
# Sandbox Example: 174379
MPESA_BUSINESS_SHORTCODE=your-business-shortcode

# Passkey for generating authentication tokens
# Get from M-Pesa Daraja portal
MPESA_PASSKEY=your-mpesa-passkey

# Callback URL where M-Pesa sends payment confirmations
# Must be accessible from the internet
# Local development example (use ngrok): https://your-ngrok-domain.ngrok-free.dev/payments/mpesa/callback/
# Production example: https://your-domain.com/payments/mpesa/callback/
MPESA_CALLBACK_URL=http://localhost:8000/payments/mpesa/callback/

# ============== EMAIL CONFIGURATION (Optional) ==============
# Required for sending notifications, password resets, appointment reminders, etc.
# By default: console backend in DEBUG mode, SMTP in production

# Email backend type (auto-selected based on DEBUG, but can be overridden)
# Development: django.core.mail.backends.console.EmailBackend (prints to stdout)
#              django.core.mail.backends.locmem.EmailBackend (in-memory for testing)
# Production: django.core.mail.backends.smtp.EmailBackend (SMTP to mail server)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Server Configuration (required for production email)
# ========== Gmail Example ==========
# 1. Enable 2-step verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password

# ========== SendGrid Example ==========
# EMAIL_PROVIDER=sendgrid
# EMAIL_SEND_ASYNC=True
# SENDGRID_API_KEY=SG.your-sendgrid-api-key
# SENDGRID_TIMEOUT=10
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Optional SMTP fallback values if you prefer Django's SMTP backend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key

# ========== AWS SES Example ==========
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-ses-smtp-username
# EMAIL_HOST_PASSWORD=your-ses-smtp-password

# Default sender email address (must match EMAIL_HOST_USER for Gmail/Office365)
DEFAULT_FROM_EMAIL=noreply@healthlink.local

# Server error email recipient
SERVER_EMAIL=noreply@healthlink.local

# Enable/disable email notifications globally (True/False)
# Useful for testing environments where you don't want real emails sent
# SEND_EMAIL_NOTIFICATIONS=True

# ============== SMS CONFIGURATION (Optional) ==============
# Required for SMS notifications

# SMS Provider API keys
# SMS_API_KEY=your-sms-provider-api-key
# SMS_API_URL=https://api.sms-provider.com/send

# ============== OPENAI / AI FEATURES (Optional) ==============
# For triage and AI features

# OpenAI API Key for triage system
# OPENAI_API_KEY=sk-your-openai-api-key

# ============== RAILWAY DEPLOYMENT ==============
# Automatically set by Railway - do not manually set these

# Your Railway domain (auto-set by Railway)
# RAILWAY_STATIC_URL=your-app.up.railway.app

# Railway environment (auto-set by Railway)
# RAILWAY_ENVIRONMENT=production

# ============== LOGGING & DEBUGGING ==============
# Optional for advanced configuration

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DJANGO_LOG_LEVEL=INFO

# ============== DEVELOPMENT ONLY ==============
# Only use these in local development

# Enable Django Debug Toolbar (development only!)
# DEBUG_TOOLBAR_ENABLED=True

# Allowed internal IPs for debugging
# INTERNAL_IPS=127.0.0.1,localhost

# Zegocloud Video API Credentials
# Get your credentials from: https://zegocloud.com/

# Zegocloud App ID (also called AppId)
# Get this from your Zegocloud dashboard: https://console.zegocloud.com/
ZEGOCLOUD_APP_ID=your_zegocloud_app_id_here

# Zegocloud Server Secret (also called ServerSecret)
# Get this from your Zegocloud dashboard
ZEGOCLOUD_SERVER_SECRET=your_zegocloud_server_secret_here
